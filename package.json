{
  "name": "tucktuck",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write . && eslint --fix .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "test:unit": "tsx --test tests/unit/permissions.test.ts tests/unit/list-query.test.ts tests/unit/secret-crypto.test.ts tests/unit/timezone.test.ts tests/unit/notify.test.ts tests/unit/monitoring.test.ts tests/unit/ssh-install.test.ts tests/unit/i18n.test.ts tests/unit/panel-url.test.ts tests/unit/server-timezone.test.ts tests/unit/robots.test.ts",
    "test": "npm run test:unit"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "npmConfig": {
    "legacy-peer-deps": true
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "jose": "^6.0.11",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.30.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "otplib": "^12.0.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socks": "^2.8.9",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.15.21",
    "@types/prop-types": "^15.7.14",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "prisma": "6.19.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
