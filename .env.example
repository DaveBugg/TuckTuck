# Образец окружения. Скопируйте в .env и заполните.
#
# Один файл на оба сценария: локальную разработку и сервер. Блок «Только сервер»
# нужен docker-compose.yml — локально он не используется.

# Базовый путь, если панель живёт не в корне домена. Впекается в бандл на
# этапе сборки, поэтому в CI задаётся переменной репозитория.
NEXT_PUBLIC_BASE_PATH=""

# --- Бэкенд TuckTuck ---
# Локально хост — localhost:5437 (см. docker-compose.dev.yml),
# на сервере — tucktuck-pg:5432 (внутренняя сеть compose).
DATABASE_URL="postgresql://tucktuck:<password>@tucktuck-pg:5432/tucktuck?schema=public"
# openssl rand -hex 32
TUCKTUCK_JWT_SECRET="<GEN openssl rand -hex 32>"

# Шифрование секретов at rest (токены ботов, креды ресурсов), AES-256-GCM.
# ОБЯЗАТЕЛЕН и отдельно от JWT: общий секрет означал бы, что ротация JWT молча
# делает нечитаемыми все сохранённые креды.
# 64 hex-символа используются как ключ напрямую; иное значение считается
# парольной фразой и растягивается scrypt'ом.
TUCKTUCK_ENCRYPTION_KEY="<GEN openssl rand -hex 32>"

# --- Cloudflare Turnstile (капча на логине) ---
# Пусто → капча выключена (fail-open, удобно для локалки/стейджинга).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY впекается в бандл на этапе СБОРКИ, поэтому в
# CI он задаётся переменной репозитория (Settings → Variables), а не отсюда.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Кеш курсов валют ---
# Redis поднимается в docker-compose.yml. Не хранилище: при недоступности панель
# просто чаще ходит в источники курсов, данные не теряются.
REDIS_URL="redis://tucktuck-redis:6379"

# --- Telegram ---
# Прокси для запросов в api.telegram.org. Нужен, если с сервера Telegram
# недоступен (так на части хостингов): без него соединение просто виснет до
# таймаута, и боты не заводятся вовсе. Формат: http://user:pass@host:port
# или socks5://host:port. Пусто = ходим напрямую.
TELEGRAM_PROXY_URL=""

# --- Первичный админ (используется `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@tucktuck.local"
# Не задан → пароль сгенерируется и напечатается ОДИН раз.
SEED_ADMIN_PASSWORD=""

# ─────────────────── Только сервер (docker-compose.yml) ───────────────────

# Пароль обязан совпадать с тем, что в DATABASE_URL выше: compose поднимает
# Postgres с этим паролем, приложение ходит по строке подключения.
POSTGRES_USER="tucktuck"
POSTGRES_PASSWORD="<GEN openssl rand -hex 24>"
POSTGRES_DB="tucktuck"

# Домен панели. Caddy сам выпустит под него сертификат Let's Encrypt, поэтому
# A-запись должна уже смотреть на сервер — иначе выпуск не пройдёт.
TUCKTUCK_DOMAIN="tucktuck.example.com"

# Порт на loopback хоста. Наружу ходит только Caddy (80/443); этот порт нужен
# deploy.sh для health-проверки с хоста.
TUCKTUCK_PORT="3000"

# Токен, которым воркер напоминаний стучится в /api/notify/run. Пустой = воркер
# работать не сможет (эндпоинт не станет публичным из-за забытой переменной).
#   openssl rand -hex 32
TUCKTUCK_WORKER_TOKEN="<GEN openssl rand -hex 32>"

# Как часто воркер проверяет напоминания. Чаще раза в сутки безопасно:
# повторная отправка отсекается на уровне БД.
NOTIFY_INTERVAL_SEC="300"

# Какой тег образов раскатывать. Обычно не трогают: scripts/deploy.sh
# выставляет его сам (аргументом — для отката на конкретную сборку).
TUCKTUCK_TAG="latest"
